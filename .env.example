# video-note key file. Copy this file to `.env.local` and fill in the values you have:
#   - development checkout: `.env.local` in the repo root (git-ignored)
#   - installed plugin:     `~/.config/video-note/.env.local` (survives plugin updates)
# One file feeds slide OCR and the cloud Whisper backends. Leave a value empty to skip it.
# Setting `VIDEO_NOTE_KEY_FILE=<path>` in the environment points video-note at another file.

# Slide detection + frame OCR (free Gemini models). The only key the default run needs.
GEMINI_API_KEY=

# Cloud Whisper fallback for videos without captions (local Whisper is tried first).
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional: a second free vision provider for the OCR judge step, and roster overrides
# (comma-separated `provider:model`, `provider` is `google` or `nim`; empty = built-in default).
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=
OCR_CANDIDATES=
OCR_JUDGES=
OCR_MIN_INTERVAL=
VIDEO_NOTE_LANG=

# Not keys, and still read from ~/.config/claude-watch/.env (see README):
# CLAUDE_WATCH_LIBRARY=/path/to/library
# WHISPER_LOCAL_CMD=/path/to/venv/python /path/to/transcribe.py {audio} --outdir {outdir}
# WHISPER_MODEL=base
